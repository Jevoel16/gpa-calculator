# Copy to .env for local development. On Vercel, add these under Project Settings > Environment Variables.

# Public address of the site, no trailing slash. OAuth callback URLs are built from it:
#   <APP_URL>/api/auth/google/callback and <APP_URL>/api/auth/github/callback
# Local: http://localhost:3000   Production: https://your-domain.com
APP_URL=http://localhost:3000

# Long random string that signs session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_string
PORT=3000

# --- Database ---
# Either a single connection URL (hosted MySQL such as TiDB Cloud, Aiven or Railway)...
# DATABASE_URL=mysql://user:password@host:4000/gpa_app
# ...or separate values (local MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gpa_app
# Hosted databases require TLS: set DB_SSL=true. DB_SSL_CA is only needed if the provider gives you a CA certificate
# (paste the PEM contents, or a file path). TiDB Cloud works with DB_SSL=true and no CA.
DB_SSL=false
# DB_SSL_CA=

# --- Google OAuth (Google Cloud Console > APIs & Services > Credentials) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- GitHub OAuth (GitHub > Settings > Developer settings > OAuth Apps) ---
# A GitHub OAuth App allows only one callback URL, so use one app for local and another for production.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: override the callback URLs built from APP_URL
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/github/callback

# --- Sign-in policy ---
# Comma-separated list of school email domains (shown on the login page; enforced when external emails are off)
ALLOWED_EMAIL_DOMAINS=g.msuiit.edu.ph

# true = any verified Google account (e.g. @gmail.com) can sign in; false = school domains only
ALLOW_EXTERNAL_EMAILS=true
