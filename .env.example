# Copy to .env and adjust values
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gpa_app
SESSION_SECRET=replace_with_a_long_random_string
PORT=3000

# Google OAuth (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Comma-separated list of school email domains (shown on the login page; enforced when external emails are off)
ALLOWED_EMAIL_DOMAINS=g.msuiit.edu.ph

# true = any verified Google account (e.g. @gmail.com) can sign in; false = school domains only
ALLOW_EXTERNAL_EMAILS=true
