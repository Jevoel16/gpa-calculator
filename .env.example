# Copy ONE block below into .env (keep only that block; repeated keys would override each other).
# For production, add the Production block's keys under Vercel > Project Settings > Environment Variables.

# ===== Local =====
# Public address, no trailing slash; OAuth callbacks are <APP_URL>/api/auth/{google,github}/callback
APP_URL=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_string
PORT=3000
# Hosted MySQL as one URL (overrides DB_*), e.g. mysql://user:password@host:4000/gpa_app
DATABASE_URL=
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gpa_app
# true for hosted databases that require TLS; DB_SSL_CA only if the provider gives a CA (PEM or file path)
DB_SSL=false
DB_SSL_CA=
# Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override; defaults to <APP_URL>/api/auth/google/callback
GOOGLE_REDIRECT_URI=
# GitHub > Settings > Developer settings > OAuth Apps (one app per environment: it allows one callback URL)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional override; defaults to <APP_URL>/api/auth/github/callback
GITHUB_REDIRECT_URI=
# Comma-separated school domains, shown on the login page and enforced when external emails are off
ALLOWED_EMAIL_DOMAINS=g.msuiit.edu.ph
# true = any verified Google/GitHub account can sign in; false = school domains only
ALLOW_EXTERNAL_EMAILS=true

# ===== Development =====
APP_URL=https://staging.your-domain.com
SESSION_SECRET=replace_with_a_different_long_random_string
PORT=3000
DATABASE_URL=mysql://user:password@dev-host:4000/gpa_app_dev
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gpa_app_dev
DB_SSL=true
DB_SSL_CA=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
ALLOWED_EMAIL_DOMAINS=g.msuiit.edu.ph
ALLOW_EXTERNAL_EMAILS=true

# ===== Production =====
APP_URL=https://your-domain.com
SESSION_SECRET=replace_with_another_long_random_string
PORT=3000
DATABASE_URL=mysql://user:password@prod-host:4000/gpa_app
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gpa_app
DB_SSL=true
DB_SSL_CA=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
ALLOWED_EMAIL_DOMAINS=g.msuiit.edu.ph
ALLOW_EXTERNAL_EMAILS=true
