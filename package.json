{
  "name": "gpa-calculator",
  "version": "1.1.0",
  "private": true,
  "description": "GPA Calculator with Google/GitHub sign-in using Node.js, Express, MySQL, HTML/CSS",
  "type": "commonjs",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --env-file .env server.js",
    "db:setup": "node scripts/setup-db.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mysql-session": "^3.0.2",
    "express-session": "^1.17.3",
    "google-auth-library": "^11.2.0",
    "mysql2": "^3.11.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
