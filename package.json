{
  "name": "gpa-calculator",
  "version": "1.2.0",
  "private": true,
  "description": "GPA Calculator with username/password and Google/GitHub sign-in using Node.js, Express, MySQL, HTML/CSS",
  "type": "commonjs",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --env-file .env server.js",
    "db:setup": "node scripts/setup-db.js",
    "db:import": "node scripts/import-terms.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "express-mysql-session": "^3.0.3",
    "express-session": "^1.18.2",
    "google-auth-library": "^11.2.0",
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  },
  "overrides": {
    "express-mysql-session": {
      "mysql2": "$mysql2"
    }
  }
}
