{
  "name": "gpa-calculator",
  "version": "1.6.3",
  "private": true,
  "description": "GPA Calculator with username/password and Google/GitHub sign-in using Node.js, Express, MySQL, HTML/CSS",
  "type": "commonjs",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch --env-file=.env server.js",
    "test": "node --test --test-force-exit",
    "db:setup": "node scripts/setup-db.js",
    "db:import": "node scripts/import-terms.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "express-mysql-session": "^3.0.3",
    "express-session": "^1.19.0",
    "google-auth-library": "^11.3.2",
    "mysql2": "^3.24.6"
  },
  "overrides": {
    "express-mysql-session": {
      "mysql2": "$mysql2"
    }
  }
}
